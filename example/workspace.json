      "summary": "A small fictional ceramics studio in Remich. Warm, unhurried, a little wry. Talks about process more than product.",
      "do": [
        "Short sentences",
        "Name the material and the hands",
        "One Luxembourgish greeting now and then (Moien!)"
      ],
      "avoid": [
        "Hype words (amazing, game-changer)",
        "Urgency tricks",
        "More than 5 hashtags"
      ],
      "address": "you",
      "languages": [
        "en",
        "fr"
      ]
    },
